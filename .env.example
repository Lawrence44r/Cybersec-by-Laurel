PORT=3000
RESEND_API_KEY=

# Stripe (Continuous Assurance Retainer self-serve subscription). Leave
# blank to keep /billing routes inert (they return a clean 503 instead of
# crashing). To go live: create a Stripe account, switch to test mode first,
# create 3 recurring Prices for $299/$599/$999 per month, and a webhook
# endpoint pointed at POST /billing/webhook listening for
# checkout.session.completed.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STANDARD=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_ENTERPRISE=

# Where the Passport Platform app is reachable from this server (not from
# the browser) for the internal provisioning call after a successful
# subscription payment. Must match that app's own PROVISION_WEBHOOK_SECRET
# exactly.
PASSPORT_PLATFORM_INTERNAL_URL=http://localhost:4100
PROVISION_WEBHOOK_SECRET=change-this-to-a-long-random-value
